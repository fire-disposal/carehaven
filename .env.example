# 智护忆站 —— 运行时环境变量示例
# 复制为 .env 并填写；.env 不进入 git。

# 微信小程序（可选；不填则微信登录返回 503）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 豆包 Seed TTS 2.0（可选；不填则问答页不显示「朗读」）
# 豆包 v3 凭据：X-Api-Key + Resource-Id
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLC_TTS_MODEL=seed-tts-2.0-standard
VOLC_TTS_SAMPLE_RATE=24000
