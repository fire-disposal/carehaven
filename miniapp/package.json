{
  "name": "carehaven-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "智护忆站 —— 失智症家庭照护者压力监测与个性化支持系统（小程序端）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "deploy:h5": "taro build --type h5 && rm -rf ../pb_public && cp -r dist ../pb_public",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.18",
    "sass": "^1.60.0",
    "terser": "^5.16.8",
    "typescript": "^5.1.0",
    "vite": "^4.5.0"
  }
}
